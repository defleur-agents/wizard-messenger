+// SPDX-License-Identifier: AGPL-3.0-or-later
+package msgconv
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+
+	"github.com/google/uuid"
+	"maunium.net/go/mautrix/bridgev2"
+	"maunium.net/go/mautrix/event"
+	"maunium.net/go/mautrix/id"
+)
+
+func TestWizardAlbumCaptionIntegrity(t *testing.T) {
+	dm := wizardFixtureMessage()
+	first := &bridgev2.ConvertedMessagePart{Type: event.EventMessage, Content: &event.MessageEventContent{
+		MsgType: event.MsgImage, Body: "Existing caption", FileName: "red.png",
+		Format: event.FormatHTML, FormattedBody: "<b>Existing caption</b>",
+		Mentions: &event.Mentions{UserIDs: []id.UserID{"@first:test"}},
+	}, Extra: map[string]any{"info": map[string]any{"fi.mau.loop": true}}}
+	second := &bridgev2.ConvertedMessagePart{Type: event.EventMessage, Content: &event.MessageEventContent{MsgType: event.MsgImage, Body: "green.png"}}
+	third := &bridgev2.ConvertedMessagePart{Type: event.EventMessage, Content: &event.MessageEventContent{MsgType: event.MsgImage, Body: "blue.png"}}
+	text := &bridgev2.ConvertedMessagePart{Type: event.EventMessage, Content: &event.MessageEventContent{
+		MsgType: event.MsgText, Body: "Three photos", Format: event.FormatHTML,
+		FormattedBody: "<i>Three photos</i>", Mentions: &event.Mentions{UserIDs: []id.UserID{"@body:test"}},
+	}}
+	if err := json.Unmarshal([]byte(`{"com.beeper.linkpreviews":[{"matched_url":"https://first.example/","og:title":"First"}]}`), first.Content); err != nil { t.Fatal(err) }
+	if err := json.Unmarshal([]byte(`{"com.beeper.linkpreviews":[{"matched_url":"https://body.example/","og:title":"Body"}]}`), text.Content); err != nil { t.Fatal(err) }
+	cm := &bridgev2.ConvertedMessage{Parts: []*bridgev2.ConvertedMessagePart{first, second, third, text}}
+	markWizardPhotoAlbum(cm, uuid.MustParse("11111111-1111-4111-8111-111111111111"), dm)
+	if len(cm.Parts) != 3 { t.Fatal("not three image parts") }
+	c := cm.Parts[0].Content
+	if c.Body != "Existing caption\n\nThree photos" || c.FileName != "red.png" || !strings.Contains(c.FormattedBody, "<b>Existing caption</b>") || !strings.Contains(c.FormattedBody, "<i>Three photos</i>") || len(c.Mentions.UserIDs) != 2 { t.Fatalf("caption integrity lost: %+v", c) }
+	if len(c.BeeperLinkPreviews) != 2 { t.Fatal("link previews lost") }
+	if cm.Parts[0].Extra["info"].(map[string]any)["fi.mau.loop"] != true { t.Fatal("GIF metadata overwritten") }
+	if cm.Parts[1] != second || cm.Parts[2] != third { t.Fatal("parts replaced/reordered") }
+}
