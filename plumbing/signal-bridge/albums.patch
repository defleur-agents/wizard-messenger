+// SPDX-License-Identifier: AGPL-3.0-or-later
+// Wizard Messenger extension for mautrix-signal, based on Tulir Asokan's converter.
+package msgconv
+
+import (
+	"github.com/google/uuid"
+	"maunium.net/go/mautrix/bridgev2"
+	"maunium.net/go/mautrix/event"
+
+	"go.mau.fi/mautrix-signal/pkg/signalid"
+	"go.mau.fi/mautrix-signal/pkg/signalmeow/protobuf/signalpb"
+)
+
+const wizardSignalAlbum = "org.wizard.signal.album"
+
+// Publish source identity without coalescing Matrix events or changing native
+// PartID mappings. A timestamp window must never be used to infer an album.
+func markWizardPhotoAlbum(cm *bridgev2.ConvertedMessage, sender uuid.UUID, dm *signalpb.DataMessage) {
+	count := len(dm.GetAttachments())
+	if dm.GetIsViewOnce() || count < 2 || count > 100 || sender == uuid.Nil || dm.GetTimestamp() == 0 {
+		return
+	}
+	// Only this DataMessage's optional trailing body may become the first photo's
+	// caption. Any failed attachment, contact, file, video or notice fails closed.
+	hasText := len(cm.Parts) == count+1 && dm.Body != nil && cm.Parts[count] != nil &&
+		cm.Parts[count].Content != nil && cm.Parts[count].Content.MsgType == event.MsgText
+	if len(cm.Parts) != count && !hasText {
+		return
+	}
+	for _, part := range cm.Parts[:count] {
+		if part == nil || part.Type != event.EventMessage || part.Content == nil || part.Content.MsgType != event.MsgImage {
+			return
+		}
+	}
+	if hasText {
+		// This upstream helper preserves HTML, mentions, previews, original file
+		// name and an existing image caption instead of overwriting that caption.
+		cm.Parts[0] = bridgev2.MergeCaption(cm.Parts[count], cm.Parts[0])
+		cm.Parts = cm.Parts[:count]
+	}
+	group := string(signalid.MakeMessageID(sender, dm.GetTimestamp()))
+	for i, part := range cm.Parts {
+		if part.Extra == nil {
+			part.Extra = make(map[string]any)
+		}
+		part.Extra[wizardSignalAlbum] = map[string]any{"id": group, "index": i, "count": count}
+	}
+}
