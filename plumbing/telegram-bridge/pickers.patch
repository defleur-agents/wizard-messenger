@@ -0,0 +1,116 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+package connector
+
+import (
+	"context"
+	"testing"
+
+	"go.mau.fi/mautrix-telegram/pkg/gotd/tg"
+)
+
+type pickerRecordingAPI struct {
+	inline   []*tg.MessagesGetInlineBotResultsRequest
+	resolved int
+	saved    int
+}
+
+func pickerSticker(docID int64, alt, pack string) *tg.Document {
+	return &tg.Document{ID: docID, MimeType: "image/webp", Attributes: []tg.DocumentAttributeClass{
+		&tg.DocumentAttributeImageSize{W: 512, H: 512},
+		&tg.DocumentAttributeSticker{Alt: alt, Stickerset: &tg.InputStickerSetShortName{ShortName: pack}},
+	}}
+}
+
+func pickerGif(docID int64) *tg.Document {
+	return &tg.Document{ID: docID, MimeType: "video/mp4", Attributes: []tg.DocumentAttributeClass{
+		&tg.DocumentAttributeVideo{W: 320, H: 180, Duration: 2.5}, &tg.DocumentAttributeAnimated{},
+	}}
+}
+
+func (a *pickerRecordingAPI) MessagesGetRecentStickers(ctx context.Context, req *tg.MessagesGetRecentStickersRequest) (tg.MessagesRecentStickersClass, error) {
+	return &tg.MessagesRecentStickers{Stickers: []tg.DocumentClass{pickerSticker(1, "😀", "Cats"), &tg.DocumentEmpty{ID: 9}}}, nil
+}
+func (a *pickerRecordingAPI) MessagesGetFavedStickers(ctx context.Context, hash int64) (tg.MessagesFavedStickersClass, error) {
+	return &tg.MessagesFavedStickers{Stickers: []tg.DocumentClass{pickerSticker(2, "❤️", "Dogs")}}, nil
+}
+func (a *pickerRecordingAPI) MessagesGetAllStickers(ctx context.Context, hash int64) (tg.MessagesAllStickersClass, error) {
+	return &tg.MessagesAllStickers{Sets: []tg.StickerSet{
+		{ShortName: "Cats", Title: "Cats", Count: 12},
+		{ShortName: "Old", Title: "Old", Count: 3, Archived: true},
+		{ShortName: "Emo", Title: "Custom emoji", Count: 40, Emojis: true},
+	}}, nil
+}
+func (a *pickerRecordingAPI) MessagesGetStickerSet(ctx context.Context, req *tg.MessagesGetStickerSetRequest) (tg.MessagesStickerSetClass, error) {
+	return &tg.MessagesStickerSetNotModified{}, nil
+}
+func (a *pickerRecordingAPI) MessagesGetSavedGifs(ctx context.Context, hash int64) (tg.MessagesSavedGifsClass, error) {
+	a.saved++
+	return &tg.MessagesSavedGifs{Gifs: []tg.DocumentClass{pickerGif(10), pickerGif(11)}}, nil
+}
+func (a *pickerRecordingAPI) ContactsResolveUsername(ctx context.Context, req *tg.ContactsResolveUsernameRequest) (*tg.ContactsResolvedPeer, error) {
+	a.resolved++
+	return &tg.ContactsResolvedPeer{Users: []tg.UserClass{&tg.User{ID: 140267078, AccessHash: 77, Bot: true, Username: req.Username}}}, nil
+}
+func (a *pickerRecordingAPI) MessagesGetInlineBotResults(ctx context.Context, req *tg.MessagesGetInlineBotResultsRequest) (*tg.MessagesBotResults, error) {
+	a.inline = append(a.inline, req)
+	return &tg.MessagesBotResults{NextOffset: "24", Results: []tg.BotInlineResultClass{
+		&tg.BotInlineMediaResult{ID: "a", Type: "gif", Document: pickerGif(20)},
+		&tg.BotInlineResult{ID: "b", Type: "article"},
+	}}, nil
+}
+
+func TestWizardStickerListsKeepOwnStickersAndInstalledPacks(t *testing.T) {
+	recent, faved, packs, err := wizardStickerLists(context.Background(), &pickerRecordingAPI{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(recent) != 1 || recent[0].ID != 1 || len(faved) != 1 || faved[0].ID != 2 {
+		t.Fatalf("recent=%v faved=%v", recent, faved)
+	}
+	if len(packs) != 1 || packs[0].ShortName != "Cats" || packs[0].Count != 12 {
+		t.Fatalf("archived/emoji packs must be hidden: %+v", packs)
+	}
+	item := wizardDescribe(recent[0], "sticker")
+	if item.ID != "1" || item.Emoji != "😀" || item.Pack != "Cats" || item.W != 512 || item.Mime != "image/webp" {
+		t.Fatalf("item %+v", item)
+	}
+}
+
+func TestWizardGifListSavedThenInlineSearch(t *testing.T) {
+	wizardDocs.gif = nil
+	api := &pickerRecordingAPI{}
+	saved, next, err := wizardGifList(context.Background(), api, "  ", "")
+	if err != nil || len(saved) != 2 || next != "" || api.saved != 1 || len(api.inline) != 0 {
+		t.Fatalf("saved=%d next=%q err=%v", len(saved), next, err)
+	}
+	found, next, err := wizardGifList(context.Background(), api, "cat", "")
+	if err != nil || len(found) != 1 || found[0].ID != 20 || next != "24" {
+		t.Fatalf("found=%v next=%q err=%v", found, next, err)
+	}
+	req := api.inline[0]
+	if bot, ok := req.Bot.(*tg.InputUser); !ok || bot.UserID != 140267078 || bot.AccessHash != 77 {
+		t.Fatalf("bot %+v", req.Bot)
+	}
+	if _, ok := req.Peer.(*tg.InputPeerSelf); !ok || req.Query != "cat" {
+		t.Fatal("inline query must be a read in Saved Messages")
+	}
+	if _, _, err := wizardGifList(context.Background(), api, "dog", "24"); err != nil || api.resolved != 1 || api.inline[1].Offset != "24" {
+		t.Fatal("bot is resolved once and the offset pages")
+	}
+	item := wizardDescribe(found[0], "gif")
+	if item.Duration != 2500 || item.W != 320 || item.Kind != "gif" {
+		t.Fatalf("gif item %+v", item)
+	}
+}
+
+func TestWizardThumbDocDropsOutlines(t *testing.T) {
+	doc := &tg.Document{ID: 5, Thumbs: []tg.PhotoSizeClass{&tg.PhotoPathSize{Type: "j"}, &tg.PhotoStrippedSize{Type: "i"}}}
+	if wizardThumbDoc(doc) != nil {
+		t.Fatal("no downloadable preview")
+	}
+	doc.Thumbs = append(doc.Thumbs, &tg.PhotoSize{Type: "m", W: 128, H: 128, Size: 4000})
+	got := wizardThumbDoc(doc)
+	if got == nil || len(got.Thumbs) != 1 || len(doc.Thumbs) != 3 {
+		t.Fatal("keeps the real size without changing the cached document")
+	}
+}
